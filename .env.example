# Copie para .env e ajuste se necessário:  cp .env.example .env

# Banco (usado pelo docker-compose)
POSTGRES_USER=salao
POSTGRES_PASSWORD=salao_dev
POSTGRES_DB=agendamento
POSTGRES_PORT=55432

# Conexão usada pela aplicação Next.js
DATABASE_URL=postgresql://salao:salao_dev@localhost:55432/agendamento

# Better Auth (gere um segredo com:  openssl rand -base64 32)
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Conta da dona criada pelo seed (npm run db:seed)
SEED_DONA_NOME=Dona do Salão
SEED_DONA_EMAIL=dona@salao.local
SEED_DONA_SENHA=trocar123

# Lembretes por e-mail (Resend; configure um remetente de domínio verificado)
RESEND_API_KEY=
LEMBRETES_REMETENTE=
